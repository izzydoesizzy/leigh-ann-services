---
// v2: the simplified site. One page, one action (Book a call).
// No pricing here on purpose. Pricing, budget and fit screening live in the intake form.
import Layout from "../layouts/EditorialLayout.astro";
import HeadingSwitcher from "../components/HeadingSwitcher.astro";
import { headings } from "../data/headings";

const base = import.meta.env.BASE_URL;

// TODO: swap for the Google intake form URL once it's ready. Every "Book a call" button uses this.
const BOOK_CALL_URL = "https://calendly.com/leighannmartin/30min";

const groups = [
  {
    title: "Calendar and inbox",
    items: [
      { name: "Calendar management", note: "Meetings, priorities and time protected for the work that matters." },
      { name: "Inbox management", note: "Triage, drafting and nothing important slipping through." },
    ],
  },
  {
    title: "Projects and clients",
    items: [
      { name: "Project management", note: "Timelines, owners and next steps everyone can see." },
      { name: "Client and event folders", note: "One organized place for every client, project and event." },
      { name: "Contracts and follow-ups", note: "Agreements tracked, renewals flagged, loops closed." },
    ],
  },
  {
    title: "Finance admin",
    items: [
      { name: "Invoice and payment tracking", note: "Know what you've billed, what's been paid, what you owe and what's still outstanding." },
    ],
  },
  {
    title: "Systems",
    items: [
      { name: "Operations and systems", note: "Simple processes that keep the business running without you in every detail." },
      { name: "Workflows in Google Workspace or your current tools", note: "Gmail, Calendar, Drive, Docs and Sheets set up to work together, or the tools you already use. Nothing new to buy." },
    ],
  },
];

const fit = [
  "Small and medium-sized businesses",
  "Owners and leaders who need their operations organized",
  "Teams that want steady support without hiring a full-time person",
  "Businesses that need reliable help behind the scenes",
];

const industries = [
  "Biotech and life sciences",
  "Finance and professional services",
  "Research and consulting",
  "Public-company operations",
  "Energy",
  "Food and hospitality",
];

const cases = [
  {
    label: "A growing company with no admin structure",
    problem: "A small, fast-growing biotech team was adding people quickly. There was no executive support function and no shared way of doing things.",
    did: "I built the support function from scratch: calendars, onboarding, shared processes and the day-to-day systems for five senior leaders.",
    changed: "Five senior leaders were supported by one organized system, and new administrative hires got up to speed 20% faster.",
    shows: "Building systems and structure from zero",
  },
  {
    label: "Recurring meetings that kept getting scrambled",
    problem: "Important quarterly meetings had nothing on the calendar. Every cycle started from scratch and depended on last-minute chasing.",
    did: "I set up a simple recurring schedule, mapped it against the company's busiest weeks, and confirmed everyone's availability well ahead of time.",
    changed: "A full year of meetings was planned 12 months in advance, and prep became routine instead of a fire drill.",
    shows: "Calendar, coordination and follow-up",
  },
];

const ways = [
  {
    name: "Done by you",
    summary: "You run it. I set you up.",
    body: "I review how things work today, then hand you simple systems, templates and a clear plan you can keep running on your own.",
  },
  {
    name: "Done with you",
    summary: "You work on it together.",
    body: "Regular check-ins and hands-on support while you build better habits and processes side by side.",
  },
  {
    name: "Done for you",
    summary: "I take it off your plate.",
    body: "I handle the day-to-day operations work directly, so you can focus on running the business.",
  },
];
---

<Layout
  title="Leigh-Ann Martin | Executive operations support"
  description="Leigh-Ann Martin provides clear, practical executive operations support for small and growing businesses. Simple packages, a human approach, and a straightforward way to book a call."
>
  <!-- Header: name + the one action -->
  <header class="sticky top-0 z-50 bg-paper/90 backdrop-blur-md border-b border-rule">
    <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href={base} class="font-display text-xl text-ink">Leigh-Ann Martin</a>
      <a
        href={BOOK_CALL_URL}
        target="_blank"
        rel="noopener"
        class="text-sm font-medium bg-ink text-paper px-5 py-2.5 rounded-full hover:bg-copper transition-colors"
      >Book a call</a>
    </div>
  </header>

  <main>
    <!-- 1. Hero -->
    <section class="px-6 pt-16 pb-20 md:pt-24 md:pb-28">
      <div class="max-w-5xl mx-auto grid md:grid-cols-12 gap-12 items-center">
        <div class="md:col-span-7" data-reveal>
          <p class="small-caps text-copper mb-6">Part-time operations support for small businesses</p>
          <h1 class="font-display text-5xl md:text-6xl text-ink mb-8" data-heading-title>{headings[0].title}</h1>
          <p class="text-lg md:text-xl text-ink-soft leading-relaxed mb-10 max-w-xl" data-heading-sub>{headings[0].sub}</p>
          <a
            href={BOOK_CALL_URL}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-3 bg-ink text-paper px-7 py-4 rounded-full font-medium hover:bg-copper transition-colors"
          >
            Book a 30-minute intro call
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>
        <div class="md:col-span-5" data-reveal>
          <img
            src={`${base}portrait.jpg`}
            alt="Leigh-Ann Martin"
            class="w-full aspect-[4/5] object-cover rounded-2xl"
            style="object-position: center top;"
          />
        </div>
      </div>
    </section>

    <!-- 2. About -->
    <section id="about" class="px-6 py-20 bg-paper-soft border-y border-rule">
      <div class="max-w-3xl mx-auto" data-reveal>
        <p class="small-caps text-copper mb-4">About</p>
        <h2 class="font-display text-4xl md:text-5xl text-ink mb-8">12+ years in operations and executive support</h2>
        <div class="space-y-5 text-lg text-ink-soft leading-relaxed">
          <p>
            I've spent more than 12 years in operations and executive support, from growing startups to public companies. Along the way I've built support functions from scratch, kept busy leadership teams organized, and turned messy processes into simple ones that people actually use.
          </p>
          <p>
            I work quietly and carefully. I pay attention to the details, I follow through, and I like leaving things more organized than I found them. You can count on me to keep things moving without needing to be reminded.
          </p>
        </div>
      </div>
    </section>

    <!-- 3. Core skills -->
    <section id="services" class="px-6 py-20 md:py-28">
      <div class="max-w-5xl mx-auto">
        <div class="max-w-2xl mb-12" data-reveal>
          <p class="small-caps text-copper mb-4">What I do</p>
          <h2 class="font-display text-4xl md:text-5xl text-ink mb-5">Services</h2>
          <p class="text-lg text-ink-soft leading-relaxed">The everyday operations work that keeps a business organized, built in Google Workspace or the tools you already use.</p>
        </div>
        <div class="grid sm:grid-cols-2 gap-x-12 border-t border-rule" data-reveal>
          {groups.map((g) => (
            <div class="py-6 border-b border-rule">
              <h3 class="font-display text-2xl text-ink mb-4">{g.title}</h3>
              <ul class="space-y-4">
                {g.items.map((s) => (
                  <li>
                    <p class="font-medium text-ink mb-0.5">{s.name}</p>
                    <p class="text-ink-muted leading-relaxed">{s.note}</p>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4 + 5. Who I work with / Experience -->
    <section class="px-6 py-20 bg-paper-deep/60 border-y border-rule">
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-16">
        <div data-reveal>
          <p class="small-caps text-copper mb-4">Who I work with</p>
          <h2 class="font-display text-3xl md:text-4xl text-ink mb-6">Owners and teams who need organized operations.</h2>
          <ul class="space-y-3 mb-6">
            {fit.map((f) => (
              <li class="flex gap-3 text-ink-soft leading-relaxed">
                <span class="text-copper mt-0.5">&#x2713;</span>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <p class="text-ink-muted leading-relaxed">
            I'm not trying to be everything to everyone. I do my best work for businesses that need systems, organization and dependable operational support.
          </p>
        </div>
        <div data-reveal>
          <p class="small-caps text-copper mb-4">Experience</p>
          <h2 class="font-display text-3xl md:text-4xl text-ink mb-6">Industries I've worked in</h2>
          <p class="text-ink-soft leading-relaxed mb-6">
            I've supported teams in very different settings, from small startups to established companies. Here are some of the industries I've worked in:
          </p>
          <ul class="flex flex-wrap gap-2">
            {industries.map((i) => (
              <li class="text-sm text-ink bg-paper border border-rule rounded-full px-4 py-2">{i}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 6. Case studies -->
    <section id="work" class="px-6 py-20 md:py-28">
      <div class="max-w-5xl mx-auto">
        <div class="max-w-2xl mb-12" data-reveal>
          <p class="small-caps text-copper mb-4">Examples</p>
          <h2 class="font-display text-4xl md:text-5xl text-ink">How I've helped other businesses</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          {cases.map((c) => (
            <article class="bg-paper-soft border border-rule rounded-2xl p-8" data-reveal>
              <h3 class="font-display text-2xl text-ink mb-6 leading-tight">{c.label}</h3>
              <dl class="space-y-5">
                <div>
                  <dt class="small-caps text-ink-muted mb-1">The problem</dt>
                  <dd class="text-ink-soft leading-relaxed">{c.problem}</dd>
                </div>
                <div>
                  <dt class="small-caps text-ink-muted mb-1">What I did</dt>
                  <dd class="text-ink-soft leading-relaxed">{c.did}</dd>
                </div>
                <div>
                  <dt class="small-caps text-ink-muted mb-1">What changed</dt>
                  <dd class="text-ink-soft leading-relaxed">{c.changed}</dd>
                </div>
              </dl>
              <p class="mt-6 pt-5 border-t border-rule text-sm text-sage font-medium">{c.shows}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 7 + 8. How we can work together / Engagement terms -->
    <section id="packages" class="px-6 py-20 md:py-28 bg-ink text-paper">
      <div class="max-w-5xl mx-auto">
        <div class="max-w-2xl mb-12" data-reveal>
          <p class="small-caps text-copper mb-4">How we can work together</p>
          <h2 class="font-display text-4xl md:text-5xl mb-5">Three ways to work together</h2>
          <p class="text-lg text-paper/70 leading-relaxed">
            Choose how hands-on you want me to be. We'll shape the details together on a call.
          </p>
        </div>
        <div class="grid md:grid-cols-3 gap-6 mb-14" data-reveal>
          {ways.map((w) => (
            <article class="border border-paper/15 rounded-2xl p-8">
              <h3 class="font-display text-2xl mb-2">{w.name}</h3>
              <p class="text-copper font-medium mb-4">{w.summary}</p>
              <p class="text-paper/70 leading-relaxed">{w.body}</p>
            </article>
          ))}
        </div>
        <div class="border-t border-paper/15 pt-10 grid md:grid-cols-12 gap-6" data-reveal>
          <p class="md:col-span-4 small-caps text-paper/50">How engagements work</p>
          <div class="md:col-span-8 space-y-4 text-paper/80 leading-relaxed">
            <p>
              I like to start with a <strong class="text-paper font-medium">1 to 3 month engagement</strong>. It gives us both time to see if it's a good fit and keeps the scope clear from day one.
            </p>
            <p>
              Longer-term support is available when the project calls for it. This is focused, part-time support with a clear scope, not full-time availability.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 9. Main CTA -->
    <section id="contact" class="px-6 py-24 md:py-32">
      <div class="max-w-2xl mx-auto text-center" data-reveal>
        <h2 class="font-display text-4xl md:text-6xl text-ink mb-6">Let's see if we're a good fit.</h2>
        <ol class="text-left max-w-md mx-auto mb-10 space-y-3 text-lg text-ink-soft leading-relaxed list-none p-0">
          <li class="flex gap-4"><span class="font-display text-2xl text-copper w-6 shrink-0">1</span><span>Book an intro call and fill in a short form about your business and where you need support.</span></li>
          <li class="flex gap-4"><span class="font-display text-2xl text-copper w-6 shrink-0">2</span><span>On the call we shape the details together: what you need and how hands-on you want me to be.</span></li>
          <li class="flex gap-4"><span class="font-display text-2xl text-copper w-6 shrink-0">3</span><span>We start with a 1 to 3 month engagement.</span></li>
        </ol>
        <a
          href={BOOK_CALL_URL}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-3 bg-ink text-paper px-8 py-4 rounded-full font-medium hover:bg-copper transition-colors"
        >
          Book a 30-minute intro call
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>
    </section>
  </main>

  <footer class="px-6 py-10 border-t border-rule">
    <div class="max-w-5xl mx-auto flex flex-col sm:flex-row justify-between gap-3 text-sm text-ink-muted">
      <p>&copy; {new Date().getFullYear()} Leigh-Ann Martin</p>
      <p>New York tri-state area &middot; Working with clients remotely</p>
    </div>
  </footer>

  <HeadingSwitcher headings={headings} />
</Layout>

<script>
  const revealEls = document.querySelectorAll("[data-reveal]");
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("revealed");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.08, rootMargin: "0px 0px -60px 0px" }
  );
  revealEls.forEach((el) => observer.observe(el));
</script>
