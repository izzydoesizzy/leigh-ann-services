---
// /capability-brief: the capability brief in the "Teal & Clay" theme (the main
// version). All copy lives in src/data/capability-brief.ts. The Editorial-theme
// version, which reads the same file, is archived at
// /archive/editorial/capability-brief-2026-11.
import TealLayout from "../layouts/TealLayout.astro";
import {
  briefPamFeature, briefPamCloser, briefJulia, briefCourtney, briefShorts, sectorLabel,
  BOOK_URL, EMAIL, LINKEDIN, stats, cases, process, packages, disciplinesCovered, credentials,
  bio, glance, tagline,
} from "../data/capability-brief.ts";

const base = import.meta.env.BASE_URL;

const contents = [
  "About",
  "By the numbers",
  "Selected work",
  "How clients describe me",
  "Ways to work together",
  "How I work",
  "Credentials",
  "Next steps",
];
---

<TealLayout
  title="Capability Brief | Leigh-Ann Martin"
  description="Leigh-Ann Martin's capability brief: experience, selected work, ways to work together, and how to get started."
>
  <!-- Header: name + actions (hidden in print) -->
  <header class="sticky top-0 z-50 bg-ivory/90 backdrop-blur-md border-b border-line print:hidden">
    <nav class="max-w-5xl mx-auto px-6 h-[4.5rem] flex items-center justify-between gap-4">
      <div class="flex items-baseline gap-4 min-w-0">
        <a href={base} class="font-serif text-xl text-espresso whitespace-nowrap">Leigh-Ann Martin</a>
        <span class="hidden md:inline eyebrow text-stone">Capability brief, 2026</span>
      </div>
      <div class="flex items-center gap-3">
        <button id="print-btn" type="button" class="btn btn-outline text-sm hidden sm:inline-flex cursor-pointer">Save as PDF</button>
        <a href={BOOK_URL} target="_blank" rel="noopener" class="btn btn-primary text-sm">Book a call</a>
      </div>
    </nav>
  </header>

  <main>
    <!-- Cover -->
    <section class="brief-page relative overflow-hidden bg-ivory">
      <div class="hero-block" aria-hidden="true"><span class="ghost-circle"></span></div>
      <div class="relative max-w-5xl mx-auto px-6 pt-14 pb-16 md:py-24 grid md:grid-cols-12 gap-12 items-center">
        <div class="md:col-span-7">
          <p class="eyebrow">Capability brief &middot; Edition 2026</p>
          <h1 class="mt-5 text-[2.6rem] md:text-[4rem] leading-[1.08] text-espresso">
            Leigh-Ann <span class="flourish">Martin<svg viewBox="0 0 220 14" preserveAspectRatio="none" aria-hidden="true"><path d="M4 10 C 60 2, 160 2, 216 8" fill="none" stroke="#C0563B" stroke-width="5" stroke-linecap="round"/></svg></span>
          </h1>
          <p class="mt-9 text-stone text-lg md:text-xl leading-relaxed max-w-xl">
            Senior Executive Assistant. Fractional partner. Twelve years running the operational layer beneath C-suite leaders.
          </p>
          <p class="mt-6 accent-line text-teal text-lg" set:html={tagline} />
          <ul class="mt-9 flex flex-wrap gap-2.5 list-none p-0">
            <li class="pill">{EMAIL}</li>
            <li class="pill">{LINKEDIN}</li>
          </ul>
        </div>
        <div class="md:col-span-5 flex justify-center md:justify-end hero-media-mobile">
          <img
            src={`${base}portrait.jpg`}
            alt="Leigh-Ann Martin"
            width="330"
            height="430"
            class="img-arch w-[min(19.5rem,70vw)] aspect-[33/43]"
            style="object-position: center top;"
          />
        </div>
      </div>
    </section>

    <!-- Contents -->
    <section class="bg-paper border-y border-line">
      <div class="max-w-5xl mx-auto px-6 py-12 md:py-14">
        <p class="eyebrow">What's in this brief</p>
        <ol class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-4 list-none p-0">
          {contents.map((c, i) => (
            <li class="flex items-baseline gap-3">
              <span class="font-serif text-xl text-teal leading-none w-5 shrink-0">{i + 1}</span>
              <a href={`#ch-${i + 1}`} class="text-espresso font-medium hover:text-teal transition-colors">{c}</a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 1. About -->
    <section id="ch-1" class="brief-page bg-ivory scroll-mt-20">
      <div class="max-w-5xl mx-auto px-6 py-20 md:py-24 grid md:grid-cols-12 gap-12">
        <div class="md:col-span-7">
          <p class="eyebrow">1 &middot; About</p>
          <h2 class="mt-4 text-3xl md:text-4xl text-espresso leading-tight">Hi, I'm Leigh-Ann.</h2>
          <div class="mt-7 space-y-5 text-[1.05rem] leading-[1.8] text-ink/90">
            {bio.map((p) => <p set:html={p} />)}
          </div>
        </div>
        <aside class="md:col-span-5">
          <div class="card p-7 md:p-8">
            <p class="eyebrow">At a glance</p>
            <dl class="mt-5 space-y-5">
              {glance.map((g) => (
                <div>
                  <dt class="eyebrow text-stone">{g.label}</dt>
                  <dd class="mt-1 text-espresso leading-relaxed" set:html={g.value} />
                </div>
              ))}
            </dl>
          </div>
        </aside>
      </div>
    </section>

    <!-- 2. By the numbers -->
    <section id="ch-2" class="brief-page bg-linen scroll-mt-20">
      <div class="max-w-5xl mx-auto px-6 py-20 md:py-24">
        <div class="max-w-2xl">
          <p class="eyebrow">2 &middot; By the numbers</p>
          <h2 class="mt-4 text-3xl md:text-4xl text-espresso leading-tight">Twelve years, measured.</h2>
          <p class="mt-4 text-stone text-lg leading-relaxed">
            Resume-backed metrics. Every figure is attested to in the career documents my references would confirm.
          </p>
        </div>
        <div class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-5">
          {stats.map((s) => (
            <div class="card p-5 md:p-6 flex flex-col">
              <span class="font-serif text-4xl md:text-[2.75rem] text-teal leading-none">{s.value}</span>
              <span class="mt-4 font-semibold text-espresso leading-snug">{s.label}</span>
              <span class="mt-1 text-stone text-sm leading-relaxed">{s.sub}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. Selected work -->
    <section id="ch-3" class="brief-page bg-ivory scroll-mt-20">
      <div class="max-w-5xl mx-auto px-6 py-20 md:py-24">
        <div class="max-w-2xl">
          <p class="eyebrow">3 &middot; Selected work</p>
          <h2 class="mt-4 text-3xl md:text-4xl text-espresso leading-tight">How I've helped other businesses</h2>
        </div>
        <div class="mt-12 space-y-6">
          {cases.map((c) => (
            <article class="case card p-7 md:p-9 grid md:grid-cols-12 gap-8">
              <div class="md:col-span-8">
                <p class="eyebrow">{c.company}</p>
                <p class="mt-1 text-stone text-sm">{c.role}</p>
                <h3 class="mt-4 text-2xl md:text-[1.75rem] text-espresso leading-tight">{c.headline}</h3>
                <p class="mt-4 text-ink leading-relaxed">{c.body}</p>
              </div>
              <dl class="md:col-span-4 md:border-l md:border-line md:pl-8 space-y-5 self-center">
                {c.metrics.map((m) => (
                  <div>
                    <dd class="font-serif text-2xl md:text-3xl text-teal leading-tight">{m.value}</dd>
                    <dt class="mt-1 text-stone text-sm">{m.label}</dt>
                  </div>
                ))}
              </dl>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. Testimonials -->
    <section id="ch-4" class="brief-page bg-espresso text-ivory scroll-mt-20">
      <div class="max-w-5xl mx-auto px-6 py-20 md:py-24">
        <div class="max-w-2xl">
          <p class="eyebrow text-teal-soft">4 &middot; In their words</p>
          <h2 class="mt-4 text-3xl md:text-4xl text-ivory leading-tight">How clients describe me</h2>
          <p class="mt-4 text-ivory/60 leading-relaxed">
            Extracts from recommendations by former executives and partners I've worked alongside. Pam Connealy's is live on LinkedIn; the others are shown by role.
          </p>
        </div>

        <figure class="mt-12">
          <blockquote class="font-serif text-2xl md:text-[2.1rem] text-ivory leading-snug">
            &ldquo;{briefPamFeature.extract}&rdquo;
          </blockquote>
          <figcaption class="mt-5 text-ivory/70">
            <span class="font-semibold text-ivory">{briefPamFeature.role}</span> &middot; {briefPamFeature.sector}
          </figcaption>
        </figure>

        <div class="mt-12 pt-10 border-t border-ivory/15 grid md:grid-cols-2 gap-x-10 gap-y-9">
          {[briefJulia, briefCourtney, ...briefShorts].map((q) => (
            <figure>
              <blockquote class="accent-line text-xl text-ivory/95 leading-snug">&ldquo;{q.extract}&rdquo;</blockquote>
              <figcaption class="mt-3 text-sm text-ivory/55">{q.role} &middot; {sectorLabel(q.sector)}</figcaption>
            </figure>
          ))}
        </div>

        <p class="mt-12 pt-10 border-t border-ivory/15 text-center accent-line text-teal-soft text-xl md:text-2xl">
          &ldquo;{briefPamCloser.extract}&rdquo;
          <span class="block mt-2 font-sans not-italic text-sm text-ivory/55">Pam Connealy</span>
        </p>
      </div>
    </section>

    <!-- 5. Ways to work together -->
    <section id="ch-5" class="brief-page relative overflow-hidden bg-sage scroll-mt-20">
      <span class="absolute -top-24 -left-24 w-80 h-80 rounded-full border border-teal/20" aria-hidden="true"></span>
      <div class="relative max-w-5xl mx-auto px-6 py-20 md:py-24">
        <div class="max-w-2xl">
          <p class="eyebrow">5 &middot; Ways to work together</p>
          <h2 class="mt-4 text-3xl md:text-4xl text-espresso leading-tight">Three ways to work together</h2>
          <p class="mt-4 text-ink text-lg leading-relaxed">
            Business systems for founders, small businesses, and executive offices. Every engagement starts with a conversation about what's breaking. Then I recommend one of three ways to work together.
          </p>
        </div>
        <div class="mt-12 grid md:grid-cols-3 gap-6">
          {packages.map((pk) => (
            <article class="card p-7 md:p-8 flex flex-col">
              <h3 class="text-2xl text-espresso">{pk.name}</h3>
              <p class="mt-2 accent-line text-teal text-lg">{pk.tag}</p>
              <p class="mt-4 text-stone leading-relaxed text-[0.95rem]">{pk.body}</p>
              <div class="mt-auto pt-6">
                <div class="pt-5 border-t border-line md:min-h-[7.5rem]">
                  <p class="eyebrow text-stone">Best for</p>
                  <p class="mt-1 text-ink text-[0.95rem] leading-relaxed">{pk.for}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
        <div class="mt-14 pt-10 border-t border-teal/20">
          <p class="eyebrow">What it can cover</p>
          <div class="mt-6 grid sm:grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-6">
            {disciplinesCovered.map((d) => (
              <div>
                <h3 class="text-xl text-espresso">{d.name}</h3>
                <p class="mt-2 text-ink/80 text-[0.95rem] leading-relaxed">{d.body}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 6. How I work -->
    <section id="ch-6" class="brief-page bg-ivory scroll-mt-20">
      <div class="max-w-3xl mx-auto px-6 py-20 md:py-24">
        <p class="eyebrow">6 &middot; How I work</p>
        <h2 class="mt-4 text-3xl md:text-4xl text-espresso leading-tight">From first call to handoff</h2>
        <ol class="mt-10 space-y-8 list-none p-0">
          {process.map((s, i) => (
            <li class="flex gap-5">
              <span class="font-serif text-3xl text-teal leading-none shrink-0 w-7">{i + 1}</span>
              <div>
                <p class="eyebrow text-stone">{s.phase} &middot; {s.time}</p>
                <h3 class="mt-1 text-xl text-espresso leading-snug">{s.title}</h3>
                <p class="mt-2 text-stone leading-relaxed">{s.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. Credentials -->
    <section id="ch-7" class="brief-page bg-paper border-y border-line scroll-mt-20">
      <div class="max-w-5xl mx-auto px-6 py-20 md:py-24">
        <p class="eyebrow">7 &middot; Credentials</p>
        <h2 class="mt-4 text-3xl md:text-4xl text-espresso leading-tight">Training and certifications</h2>
        <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {credentials.map((c) => (
            <article class="rounded-[1.25rem] border border-line bg-ivory p-6 flex flex-col">
              <p class="eyebrow">{c.kind}</p>
              <h3 class="mt-3 text-xl text-espresso leading-snug">{c.name}</h3>
              <p class="mt-auto pt-4 text-stone text-sm leading-relaxed" set:html={c.detail} />
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 8. Next steps -->
    <section id="ch-8" class="brief-page bg-linen scroll-mt-20">
      <div class="max-w-2xl mx-auto px-6 py-24 md:py-28 text-center">
        <p class="eyebrow">8 &middot; Next steps</p>
        <h2 class="mt-4 text-3xl md:text-5xl text-espresso leading-tight">Let's see if we're a good fit.</h2>
        <p class="mt-6 text-stone text-lg leading-relaxed">
          If any chapter of this brief sounds like your week, the next step is a free 30-minute call. Fill out a two-minute form, then pick a time.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href={BOOK_URL} target="_blank" rel="noopener" class="btn btn-primary">Book a 30-minute call</a>
          <a href={`mailto:${EMAIL}?subject=Re%3A%20Capability%20Brief`} class="btn btn-outline">{EMAIL}</a>
        </div>
        <p class="mt-6 accent-line text-teal text-lg">I work with a small number of clients at a time.</p>
      </div>
    </section>
  </main>

  <footer class="bg-espresso text-ivory/80 print:hidden">
    <div class="max-w-5xl mx-auto px-6 py-8 text-sm text-ivory/55 flex flex-col sm:flex-row justify-between gap-3">
      <p><span class="font-serif text-lg text-ivory">Leigh-Ann Martin</span> &middot; Capability brief, 2026</p>
      <p>
        <a href={base} class="hover:text-ivory transition-colors">Main site</a> &middot;
        <a href={`https://www.${LINKEDIN}`} target="_blank" rel="noopener" class="hover:text-ivory transition-colors">LinkedIn</a> &middot;
        <a href={`mailto:${EMAIL}`} class="hover:text-ivory transition-colors">{EMAIL}</a>
      </p>
    </div>
  </footer>
</TealLayout>

<script>
  document.getElementById("print-btn")?.addEventListener("click", () => window.print());
</script>

<style is:global>
  @media print {
    @page {
      margin: 16mm 14mm;
      size: letter;
    }
    html,
    body {
      background: #fff !important;
    }
    .brief-page {
      break-after: page;
    }
    .brief-page:last-of-type {
      break-after: auto;
    }
    .card,
    .case,
    figure,
    li {
      break-inside: avoid;
    }
    .card {
      box-shadow: none;
    }
    * {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
  }
</style>
